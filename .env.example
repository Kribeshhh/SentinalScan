# Reference only: app.py does not automatically load .env files.
# Set variables in the server environment. Never commit actual credentials.

# Optional advanced fallback. You can also paste a token on the Repository Scan page.
# Public GitHub repositories work without a token.
# Use a narrowly scoped, read-only fine-grained PAT for authorized private repos.
SENTINELSCAN_GITHUB_TOKEN=

# Optional: unset uses the project's data/ directory.
# SENTINELSCAN_DATA_DIR=/absolute/private/path/sentinelscan-data

# Optional: unset generates and persists a private random key in data/.secret_key.
# If set, supply a random value of at least 32 characters.
# SENTINELSCAN_SECRET_KEY=

# Keep unset/0 for local HTTP. Set 1 only behind correctly configured HTTPS.
SENTINELSCAN_HTTPS=0
